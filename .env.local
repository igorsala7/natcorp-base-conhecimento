# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3008


# IA (provedores, chaves, modelos e finalidades) agora é configurada em
# Admin → Sistema → IA e guardada no BANCO. As antigas AI_PROVIDER / AI_API_KEY /
# CHAT_MODEL / EMBEDDING_* / TRANSCRIBE_MODEL só existiam como fallback de
# ambiente e foram removidas daqui — o app usa o que está no banco.

# SMTP dos e-mails de autenticação: dashboard do Supabase (Auth → SMTP Settings).

# TEMPORARIO: desliga a exigencia de 2FA (TOTP) no admin.
# Remover esta linha para voltar ao normal. NUNCA usar em producao.
MFA_DISABLED=true

# --- Escala / multi-tenant -------------------------------------------------
# Semáforo de concorrência de IA por base (fair-share). Já ativo por padrão.
AI_MAX_CONCURRENCY_PER_BASE=20
AI_LEASE_TTL_SECONDS=120
# Cota diária de tokens por base (vazio/0 = sem cota; ajuste por base em tenant_limits).
AI_DAILY_TOKEN_CAP_PER_BASE=
# Disjuntor do provedor de LLM (já ativo por padrão).
AI_CB_FAILURES=5
AI_CB_WINDOW_MS=30000
AI_CB_COOLDOWN_MS=20000
# Cache KV (Redis Upstash REST). Vazio = cache em memória.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Mesma chave do .env de produção — sem isso, segredo gravado cifrado lá não abre aqui.
APP_ENCRYPTION_KEY=zqaoMA6y9gVWAUUPq-Xjwmrm9uRzuHShp9CG4i8i-MB2USx2gmBI2BvLk4UoMrEw

# O `.env` (produção) define NEXT_PUBLIC_BASE_PATH=/natcorp/ia e o Next carrega os
# dois arquivos — com o `.env.local` VENCENDO. Aqui ele volta a VAZIO para o
# desenvolvimento continuar na raiz (http://localhost:3008/), como sempre foi.
NEXT_PUBLIC_BASE_PATH=
