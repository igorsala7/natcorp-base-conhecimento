{
  "name": "natcorp-base-conhecimento",
  "version": "0.1.0",
  "description": "Repositório da base de conhecimento da Natcorp.",
  "scripts": {
    "test": "vitest run",
    "dev": "next dev -p 3008",
    "build": "next build",
    "start": "next start -p 3008",
    "start:prod": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "seed": "tsx --env-file=.env.local scripts/seed-admin.ts",
    "seed:prod": "tsx scripts/seed-admin.ts",
    "bootstrap:owner": "tsx --env-file=.env.local scripts/bootstrap-owner.ts",
    "bootstrap:owner:prod": "tsx scripts/bootstrap-owner.ts",
    "seed:natcorp": "tsx --env-file=.env.local scripts/seed-natcorp.ts",
    "verificar:ui": "node scripts/verificar-ui.mjs",
    "seed:bases": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/seed-bases-clientes.ts",
    "tools:ferias": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/add-ferias-tools.ts",
    "tools:ferias:prod": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/add-ferias-tools.ts",
    "smoke:ferias": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/smoke-ferias-body.ts",
    "tool:consulta-ir": "tsx --env-file=.env.local scripts/add-consulta-ir-tool.ts",
    "tools:estrutura": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/add-estrutura-tools.ts",
    "seed:natcorp:prod": "tsx scripts/seed-natcorp.ts",
    "worker": "tsx --tsconfig worker/tsconfig.json --env-file=.env.local worker/index.ts",
    "worker:prod": "tsx --tsconfig worker/tsconfig.json worker/index.ts",
    "simular:selecao": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/simular-selecao.ts",
    "embed:tools": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/embed-tools.ts",
    "embed:tools:base": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/embed-tools-base.ts",
    "gen:search-terms": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/gen-search-terms.ts",
    "gen:descricao-usuario": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/gen-descricao-usuario.ts",
    "migrate:blocks": "tsx --env-file=.env.local scripts/migrate-blocks.ts",
    "eval:extrair": "tsx --env-file=.env.local scripts/extrair-casos.ts",
    "eval:cenarios": "tsx --env-file=.env.local scripts/extrair-cenarios.ts",
    "tools:situacao": "tsx --env-file=.env.local scripts/padrao-situacao-ativo.ts",
    "tools:loop-opcional": "tsx --env-file=.env.local scripts/loop-param-opcional.ts",
    "eval:tools": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/eval-tools.ts",
    "eval:rewrite": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/eval-rewrite.ts",
    "eval:rewrite-modelo": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/eval-rewrite-modelo.ts",
    "eval:modelos": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/eval-modelos.ts",
    "eval:cenarios-modelo": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/eval-cenarios.ts",
    "rodada:e2e": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/rodada-e2e.ts",
    "migrate:apply": "tsx --env-file=.env.local scripts/apply-migrations.ts",
    "migrate:apply:prod": "tsx scripts/apply-migrations.ts",
    "test:e2e": "playwright test",
    "sync:agents": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/sync-agents.ts",
    "rekey": "tsx --env-file=.env.local scripts/rekey-secrets.ts",
    "rekey:prod": "tsx --env-file=.env scripts/rekey-secrets.ts",
    "seed:graph": "tsx --env-file=.env.local scripts/seed-graph-tools.ts",
    "seed:graph:prod": "tsx --env-file=.env scripts/seed-graph-tools.ts",
    "seed:graph:write": "tsx --env-file=.env.local scripts/seed-graph-write.ts",
    "seed:graph:write:prod": "tsx --env-file=.env scripts/seed-graph-write.ts",
    "seed:graph:modulos": "tsx --env-file=.env.local scripts/seed-graph-modules.ts",
    "seed:graph:modulos:prod": "tsx --env-file=.env scripts/seed-graph-modules.ts",
    "relatorio:amostra": "tsx --tsconfig worker/tsconfig.json scripts/amostra-relatorio.ts"
  },
  "repository": {
    "type": "git",
