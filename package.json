    "@supabase/supabase-js": "^2.109.0",
    "@tanstack/react-query": "^5.101.2",
    "@types/nodemailer": "^8.0.1",
    "@xyflow/react": "^12.11.2",
    "ai": "^6.0.230",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "fractional-indexing": "^4.0.0",
    "geist": "^1.7.2",
    "highlight.js": "^11.11.1",
    "isomorphic-dompurify": "^3.19.0",
    "jszip": "^3.10.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.25.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.0",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pg-boss": "^10.4.2",
