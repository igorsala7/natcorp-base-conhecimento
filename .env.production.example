# ============================================================================
# Configuração de PRODUÇÃO — copie este arquivo para .env e preencha os valores:
#     cp .env.production.example .env
#
# O docker-compose lê o .env para o BUILD (variáveis NEXT_PUBLIC_*, embutidas no
# bundle) e para o RUNTIME (todas as demais). NUNCA versione o .env preenchido.
# ============================================================================

# --- Porta do serviço -------------------------------------------------------
# WEB_PORT = porta PUBLICADA no servidor (a que você acessa / põe no proxy).
# PORT     = porta que o Next escuta DENTRO do container.
# Para trocar a porta em produção, mude WEB_PORT (PORT pode ficar 3000).
WEB_PORT=3000
PORT=3000

# --- URL pública ------------------------------------------------------------
# Embutida no build (links, sitemap, OG, código de <iframe> de incorporação).
# Se mudar o domínio, é preciso RECONSTRUIR a imagem (docker compose build).
NEXT_PUBLIC_SITE_URL=https://docs.suaempresa.com.br

# --- Supabase (obrigatório) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...            # chave pública (anon)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...                # SÓ servidor — nunca expor
# Conexão direta ao Postgres (worker/migrations). A senha pode conter @ e #.
SUPABASE_DB_URL=postgresql://postgres:SUA_SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# --- Segredos do app --------------------------------------------------------
# Chave-mestra que cifra segredos guardados no banco (provedores de IA, SMTP…).
APP_ENCRYPTION_KEY=gere-uma-string-longa-e-aleatoria-32+chars
# Assina os cookies de acesso a documentação protegida por senha.
PORTAL_COOKIE_SECRET=gere-outra-string-aleatoria-distinta

# --- IA ---------------------------------------------------------------------
# Provedores, chaves de API, modelos e finalidades (chat, embeddings, transcrição,
# editor, importador) são configurados em Admin → Sistema → IA e guardados no
# BANCO, cifrados com APP_ENCRYPTION_KEY. Não há variáveis de IA no ambiente.

# --- Escala / multi-tenant (opcional) --------------------------------------
# Semáforo de concorrência de IA POR BASE (fair-share entre clientes). Já ATIVO
# por padrão (20); ajuste conforme o tier do provedor. Lease com TTL em segundos.
AI_MAX_CONCURRENCY_PER_BASE=20
AI_LEASE_TTL_SECONDS=120
# Cota diária de tokens POR BASE (rede de segurança contra custo descontrolado).
# Vazio/0 = SEM cota (só o semáforo atua). Ajuste fino por base em tenant_limits.
AI_DAILY_TOKEN_CAP_PER_BASE=

# Disjuntor do provedor de LLM (já ATIVO por padrão): abre o circuito após N
# falhas de provedor (429/5xx/timeout) na janela, por um cooldown (ms).
AI_CB_FAILURES=5
AI_CB_WINDOW_MS=30000
AI_CB_COOLDOWN_MS=20000

# Cache KV (Redis Upstash via REST). VAZIO = cache em memória por instância.
# Crie um banco em upstash.com → copie a REST URL e o REST TOKEN aqui.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Outros -----------------------------------------------------------------
NODE_ENV=production
# MFA_DISABLED=1   # desabilita o 2FA (TOTP). Não recomendado em produção.
