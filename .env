# Ambiente de PRODUÇÃO — servidor nginx, app sob https://www.natcorpbr.com.br/natcorp/ia
#
# O docker compose lê este arquivo DUAS vezes:
#   · no BUILD, para as NEXT_PUBLIC_* (embutidas no bundle do navegador);
#   · em RUNTIME, via env_file, para todo o resto.
# Trocar qualquer NEXT_PUBLIC_* exige `docker compose up -d --build`.

# ── Rede ─────────────────────────────────────────────────────────────────────
# WEB_PORT = porta publicada no servidor; PORT = porta dentro do contêiner.
WEB_PORT=3008
PORT=3008

# ── Endereço público ─────────────────────────────────────────────────────────
# O app NÃO fica na raiz do domínio: o nginx serve em /natcorp/ia.
# O NEXT_PUBLIC_BASE_PATH faz o Next gerar rotas e assets já com o prefixo — e o
# nginx precisa repassar o caminho COMPLETO (proxy_pass SEM barra no fim).
NEXT_PUBLIC_SITE_URL=https://www.natcorpbr.com.br/natcorp/ia
NEXT_PUBLIC_BASE_PATH=/natcorp/ia

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://vshoplhrhnjbvyfikxdb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZzaG9wbGhyaG5qYnZ5ZmlreGRiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQzNzQzOTQsImV4cCI6MjA5OTk1MDM5NH0.BU1WulENHfi49kcNj6w47ZbxeP1UGtBIJbMvzZ_cpVU
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZzaG9wbGhyaG5qYnZ5ZmlreGRiIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NDM3NDM5NCwiZXhwIjoyMDk5OTUwMzk0fQ.cqqPw7dl2l_NGsjhr4ylCsj-wVcHtw_w3LsMzRinq2M
SUPABASE_DB_URL="postgresql://postgres:Davout123!@#@db.vshoplhrhnjbvyfikxdb.supabase.co:5432/postgres"

# ── Segredos da aplicação ────────────────────────────────────────────────────
# APP_ENCRYPTION_KEY cifra os segredos guardados no banco (credenciais OAuth das
# Integrações, chaves de rastreio). Hoje eles estão como `plain:` — continuam
# legíveis depois de ligar a chave; só as GRAVAÇÕES novas passam a ser cifradas.
# Use o MESMO valor no .env.local, senão o que a produção gravar cifrado não abre
# em desenvolvimento.
APP_ENCRYPTION_KEY=zqaoMA6y9gVWAUUPq-Xjwmrm9uRzuHShp9CG4i8i-MB2USx2gmBI2BvLk4UoMrEw
PORTAL_COOKIE_SECRET=l5iEq4DrrsVFb33QYpXDHbz-Ug7Av8tF02FW67pHUVggEp_YKqhLVJ9W2mkhKYS_

# ── Segurança ────────────────────────────────────────────────────────────────
# 2FA (TOTP) DESLIGADO por decisão do Igor (ago/2026): a entrada é só e-mail +
# senha. O servidor loga "[SEGURANÇA] 2FA desativado por MFA_DISABLED=true" a
# cada acesso ao admin — o aviso é proposital, não é erro.
#
# Para religar o 2FA: apague a linha abaixo (o padrão SEM a variável é exigir
# TOTP) e reinicie o container. Cada admin cadastra o autenticador no 1º login.
MFA_DISABLED=true

# ── Limites de IA (mesmos valores do desenvolvimento) ────────────────────────
AI_MAX_CONCURRENCY_PER_BASE=20
AI_LEASE_TTL_SECONDS=120
AI_DAILY_TOKEN_CAP_PER_BASE=
AI_CB_FAILURES=5
AI_CB_WINDOW_MS=30000
AI_CB_COOLDOWN_MS=20000

# ── Redis (fila/limites) ─────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NODE_ENV=production
