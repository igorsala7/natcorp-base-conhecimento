# Copie para .env.local (cp, não mv!) e preencha com os valores do SEU projeto Supabase.
# NUNCA versione .env.local. A service_role só existe no servidor.

# --- Supabase (Project Settings → API) ---
# ATENÇÃO: use a "Project URL" (ex.: https://xxxx.supabase.co) — SEM /rest/v1/ no fim.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só servidor. Se aparecer em código "use client" ou em NEXT_PUBLIC_*, o build está quebrado.
SUPABASE_SERVICE_ROLE_KEY=

# Connection string do Postgres (URI) — Project Settings → Database → Connection string.
# É um postgresql://... (NÃO a URL https:// da API). Usada por migrations/scripts.
SUPABASE_DB_URL=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3008

# Assina o cookie de acesso às documentações protegidas por senha.
# Opcional: em branco, cai na service_role (comportamento anterior). Preencher
# desacopla as duas — rotacionar a chave do banco deixa de deslogar os leitores.
# Gere com: openssl rand -hex 32
PORTAL_COOKIE_SECRET=

# --- IA (reservado para a Fase 6; deixe em branco por ora) ---
AI_PROVIDER=
AI_API_KEY=
EMBEDDING_MODEL=
CHAT_MODEL=

# Observação: o SMTP dos e-mails de autenticação é configurado no dashboard
# do Supabase (Auth → SMTP Settings), não aqui.

# --- Escala / multi-tenant -------------------------------------------------
# Semáforo de concorrência de IA por base (fair-share). Já ativo por padrão.
AI_MAX_CONCURRENCY_PER_BASE=20
AI_LEASE_TTL_SECONDS=120
# Cota diária de tokens por base (vazio/0 = sem cota; ajuste por base em tenant_limits).
AI_DAILY_TOKEN_CAP_PER_BASE=
# Disjuntor do provedor de LLM (já ativo por padrão).
AI_CB_FAILURES=5
AI_CB_WINDOW_MS=30000
AI_CB_COOLDOWN_MS=20000
# Cache KV (Redis Upstash REST). Vazio = cache em memória.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
